<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon 背景层：与前景同色（纯橙 #FFFF6B00）。
  某些 OEM launcher 会单独渲染 background，再覆盖 foreground —— 如果 background 与
  前景中央元素不同色，看起来就是「四周有色、中央白色卡片/盒子」造成「只显示中间」错觉。
  这里 background 用同色 + 前景也用同色圆角方块，让两层颜色一致 → 视觉上不会断色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFF6B00"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>