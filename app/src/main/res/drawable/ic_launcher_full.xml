<?xml version="1.0" encoding="utf-8"?>
<!--
  单 vector 启动图标：圆角方块（纯色橙）+ 弹出的照片卡 + 盒子 + 星光。
  viewBox 108x108，所有元素直接画在 viewport 内（不再使用 adaptive-icon 分层），
  绕开部分 OEM launcher 不渲染 <background>/<foreground> 分层、导致前景元素
  漂浮在透明/默认背景上只显示"中间"的问题。

  颜色 #FFFF6B00 取 logo.svg 渐变起始色；几何严格对齐 logo.svg：
  - 圆角 rx=24（viewBox 108 下），原 logo.svg viewBox 120 rx=27 → 27/120 = 0.225，
    108 * 0.225 ≈ 24.3，取整 24
  - 元素坐标按比例从 logo.svg 的 120 缩放到 108（* 0.9）后微调到 launcher 安全区
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角方块背景（满铺 108x108，圆角 24） -->
    <path
        android:fillColor="#FFFF6B00"
        android:pathData="M0,0 L84,0 A24,24 0 0 1 108,24 L108,84 A24,24 0 0 1 84,108 L24,108 A24,24 0 0 1 0,84 L0,24 A24,24 0 0 1 24,0 Z" />

    <!-- 弹出的照片卡：旋转 -14°，中心 (54, 41.4) -->
    <group
        android:pivotX="54"
        android:pivotY="41.4"
        android:rotation="-14">
        <!-- 卡片白底 -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M37,16 L74,16 A5,5 0 0 1 79,21 L79,58 A5,5 0 0 1 74,63 L37,63 A5,5 0 0 1 32,58 L32,21 A5,5 0 0 1 37,16 Z" />
        <!-- 卡片橙色窗口 -->
        <path
            android:fillColor="#FFFF6B00"
            android:pathData="M41,20 L70,20 A3,3 0 0 1 73,23 L73,46 A3,3 0 0 1 70,49 L41,49 A3,3 0 0 1 38,46 L38,23 A3,3 0 0 1 41,20 Z" />
        <!-- 白色小圆 -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M48,28 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
        <!-- 山形景色 -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M38,46 L45,38 L50,43 L55,38 L65,49 L41,49 A3,3 0 0 1 38,46 Z" />
        <!-- 浅橙色装饰条 -->
        <path
            android:fillColor="#FFFFD9BD"
            android:pathData="M41,53 L57,53 A3,3 0 0 1 57,59 L41,59 A3,3 0 0 1 41,53 Z" />
    </group>

    <!-- 盒子主体 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,58 L84,58 L84,82 A8,8 0 0 1 76,90 L32,90 A8,8 0 0 1 24,82 Z" />

    <!-- 盒子顶部阴影 -->
    <path
        android:fillColor="#FF000000"
        android:fillAlpha="0.07"
        android:pathData="M24,58 L84,58 L84,66 L24,66 Z" />

    <!-- 中间色带 -->
    <path
        android:fillColor="#FFFF6B00"
        android:pathData="M47,58 L61,58 L61,90 L47,90 Z" />

    <!-- 左盒盖 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M24,58 L13,49 A2.5,2.5 0 0 1 14.7,44 L34,44 Z" />

    <!-- 右盒盖 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M84,58 L95,49 A2.5,2.5 0 0 0 93.3,44 L74,44 Z" />

    <!-- 星光（右上） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M84,20 L86,25 L91,27 L86,29 L84,34 L82,29 L77,27 L82,25 Z" />

    <!-- 星光（左中） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M22,28 L23.2,31.2 L26.4,32.4 L23.2,33.6 L22,36.8 L20.8,33.6 L17.6,32.4 L20.8,31.2 Z" />

    <!-- 右下小圆点 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.8"
        android:pathData="M86,42 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
</vector>